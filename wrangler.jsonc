{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-r2-webdav",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-27",
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "webdav"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "METADATA",
				"class_name": "WebDavMetadata"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["WebDavMetadata"]
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	]
}
